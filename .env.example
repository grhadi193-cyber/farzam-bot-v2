# Copy to .env and fill in. Never commit .env. Never put a token in chat.
PORT=3100
# New BotFather token for the v2 bot. A new username/token until cutover.
TELEGRAM_BOT_TOKEN=
# Secret Telegram sends in X-Telegram-Bot-Api-Secret-Token on webhook calls.
TELEGRAM_WEBHOOK_SECRET=
# Public URL Telegram calls, e.g. https://bot.example.com/telegram/webhook
WEBHOOK_URL=
# JSON map of first-login access codes. Example: {"1234":{"name":"Ali","role":"admin"}}. Keep secret.
TELEGRAM_ACCESS_CODES_JSON=
# Pip's key for /api/pip/* — separate from TELEGRAM_BOT_TOKEN and the ERP key.
PIP_BOT_API_KEY=
# Local file DB. Set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN in production.
DATABASE_URL=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Seconds messages from one sender are grouped into one event. Default 180.
GROUP_WINDOW_SECONDS=180
# Poll Telegram instead of webhook (local dev only). Never with a webhook.
POLLING=false
# Where downloaded Telegram files live.
FILES_DIR=./data/files
# Optional: python that has faster-whisper, for Persian voice transcription.
# Defaults to ~/workspace/venvs/whisper/bin/python when it exists.
WHISPER_PYTHON=
WHISPER_MODEL=small
